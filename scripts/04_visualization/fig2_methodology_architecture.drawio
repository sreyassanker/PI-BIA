        <!-- Bottom Synthesis Callout in Panel a: Clean 2-Line Wrap With Zero Orphans -->
        <mxCell id="aCallout" value="&lt;b&gt;The PI-BIA Solution:&lt;/b&gt; Physics-constrained Bayesian downscaling bridges the multi-scale spatial gap&lt;br&gt;by coupling epithermal neutron flux (&amp;lt; 1 m) with MOLA topography and empirical impact excavations." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#475569;strokeWidth=1.5;fontFamily=Helvetica;fontSize=10.5;fontColor=#0F172A;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1">
          <mxGeometry x="95" y="840" width="510" height="68" as="geometry" />
        </mxCell>

