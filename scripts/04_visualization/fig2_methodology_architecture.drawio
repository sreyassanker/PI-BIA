        <!-- ===================== PANEL B: EXPANDED FORMULATION & COMPLETE SCORECARD ===================== -->
        <!-- Left: Model Formulation Card -->
        <mxCell id="formCard" value="" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="650" y="512" width="708" height="396" as="geometry" />
        </mxCell>
        <mxCell id="formTitle" value="&lt;b&gt;Mathematical Formulation &amp;amp; Bayesian Uncertainty Framework&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=13.5;fontStyle=1;fontColor=#0F172A;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="668" y="522" width="450" height="22" as="geometry" />
        </mxCell>
        <mxCell id="formSub" value="&lt;i&gt;β&lt;sub&gt;CEPI&lt;/sub&gt; ≤ 0, β&lt;sub&gt;lat&lt;/sub&gt; ≥ 0 &amp;nbsp;|&amp;nbsp; &lt;b&gt;H&lt;/b&gt; = ∇&lt;sup&gt;2&lt;/sup&gt;(−log p)&lt;/i&gt;" style="text;html=1;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=11;fontColor=#64748B;align=right;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1080" y="523" width="260" height="20" as="geometry" />
        </mxCell>
        <mxCell id="formDiv" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E2E8F0;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="668" y="548" width="672" height="1.5" as="geometry" />
        </mxCell>
        <mxCell id="formEquations" value="&lt;div style=&quot;font-size:12.5px; line-height:1.48; color:#0F172A;&quot;&gt;
  &lt;div style=&quot;font-weight:bold; font-size:13.5px; color:#0F172A; margin-bottom:5px;&quot;&gt;1 · Physics-Constrained Logistic Ice Detection Classifier:&lt;/div&gt;
  &lt;div style=&quot;margin-left:14px; margin-bottom:14px;&quot;&gt;
    P(ice = 1 | &lt;b&gt;x&lt;/b&gt;) = σ(β&lt;sub&gt;0&lt;/sub&gt; + &lt;b&gt;β&lt;/b&gt;&lt;sup&gt;T&lt;/sup&gt;&lt;b&gt;x̃&lt;/b&gt;) = 1 / [1 + exp(−(β&lt;sub&gt;0&lt;/sub&gt; + &lt;b&gt;β&lt;/b&gt;&lt;sup&gt;T&lt;/sup&gt;&lt;b&gt;x̃&lt;/b&gt;))], &amp;nbsp;&amp;nbsp;&lt;b&gt;s.t.&lt;/b&gt;&amp;nbsp;&amp;nbsp;β&lt;sub&gt;CEPI&lt;/sub&gt; ≤ 0, &amp;nbsp;β&lt;sub&gt;lat&lt;/sub&gt; ≥ 0&lt;br&gt;
    ℒ(&lt;b&gt;β&lt;/b&gt;, β&lt;sub&gt;0&lt;/sub&gt;) = −∑&lt;sub&gt;i=1&lt;/sub&gt;&lt;sup&gt;N&lt;/sup&gt; [ y&lt;sub&gt;i&lt;/sub&gt; ln P&lt;sub&gt;i&lt;/sub&gt; + (1 − y&lt;sub&gt;i&lt;/sub&gt;) ln(1 − P&lt;sub&gt;i&lt;/sub&gt;) ] + (λ/2) ||&lt;b&gt;β&lt;/b&gt;||&lt;sub&gt;2&lt;/sub&gt;&lt;sup&gt;2&lt;/sup&gt; &amp;nbsp;&amp;nbsp;(λ = 0.5, bounded L-BFGS-B)&lt;br&gt;
    &lt;span style=&quot;color:#64748B; font-size:11px;&quot;&gt;Standardized features &lt;b&gt;x̃&lt;/b&gt; = [lat, lon, z&lt;sub&gt;MOLA&lt;/sub&gt;, θ&lt;sub&gt;slope&lt;/sub&gt;, Φ&lt;sub&gt;CEPI&lt;/sub&gt;]&lt;sup&gt;T&lt;/sup&gt; ∈ ℝ&lt;sup&gt;5&lt;/sup&gt; with physical gradient monotonicity&lt;/span&gt;
  &lt;/div&gt;

  &lt;div style=&quot;font-weight:bold; font-size:13.5px; color:#0F172A; margin-top:12px; margin-bottom:5px;&quot;&gt;2 · Laplace Epistemic Uncertainty &amp;amp; Bayesian Depth Inversion:&lt;/div&gt;
  &lt;div style=&quot;margin-left:14px; margin-bottom:14px;&quot;&gt;
    &lt;b&gt;Σ&lt;/b&gt;&lt;sub&gt;Laplace&lt;/sub&gt; = (&lt;b&gt;H&lt;/b&gt; + λ&lt;b&gt;I&lt;/b&gt;)&lt;sup&gt;−1&lt;/sup&gt;, &amp;nbsp;&amp;nbsp;&lt;b&gt;H&lt;/b&gt; = ∇&lt;sub&gt;&lt;b&gt;θ&lt;/b&gt;&lt;/sub&gt;&lt;sup&gt;2&lt;/sup&gt;(−ln p(𝒟 | &lt;b&gt;θ&lt;/b&gt;))|&lt;sub&gt;&lt;b&gt;θ̂&lt;/b&gt;&lt;sub&gt;MAP&lt;/sub&gt;&lt;/sub&gt;, &amp;nbsp;&amp;nbsp;σ&lt;sub&gt;prob&lt;/sub&gt;&lt;sup&gt;2&lt;/sup&gt;(&lt;b&gt;x&lt;/b&gt;) = (∇&lt;sub&gt;&lt;b&gt;θ&lt;/b&gt;&lt;/sub&gt; P)&lt;sup&gt;T&lt;/sup&gt; &lt;b&gt;Σ&lt;/b&gt;&lt;sub&gt;Laplace&lt;/sub&gt; (∇&lt;sub&gt;&lt;b&gt;θ&lt;/b&gt;&lt;/sub&gt; P)&lt;br&gt;
    Stage II Analytical Posterior: &amp;nbsp;&lt;b&gt;Σ&lt;/b&gt;&lt;sub&gt;w&lt;/sub&gt; = (λ&lt;sub&gt;noise&lt;/sub&gt; &lt;b&gt;X&lt;/b&gt;&lt;sup&gt;T&lt;/sup&gt;&lt;b&gt;X&lt;/b&gt; + α&lt;b&gt;I&lt;/b&gt;)&lt;sup&gt;−1&lt;/sup&gt;, &amp;nbsp;&amp;nbsp;&lt;b&gt;μ&lt;/b&gt;&lt;sub&gt;w&lt;/sub&gt; = λ&lt;sub&gt;noise&lt;/sub&gt; &lt;b&gt;Σ&lt;/b&gt;&lt;sub&gt;w&lt;/sub&gt; &lt;b&gt;X&lt;/b&gt;&lt;sup&gt;T&lt;/sup&gt; &lt;b&gt;y&lt;/b&gt;&lt;sub&gt;depth&lt;/sub&gt;&lt;br&gt;
    D(&lt;b&gt;x&lt;/b&gt;) ~ 𝒩(&lt;b&gt;x̃&lt;/b&gt;&lt;sup&gt;T&lt;/sup&gt;&lt;b&gt;μ&lt;/b&gt;&lt;sub&gt;w&lt;/sub&gt;, &amp;nbsp;σ&lt;sub&gt;noise&lt;/sub&gt;&lt;sup&gt;2&lt;/sup&gt; + &lt;b&gt;x̃&lt;/b&gt;&lt;sup&gt;T&lt;/sup&gt;&lt;b&gt;Σ&lt;/b&gt;&lt;sub&gt;w&lt;/sub&gt;&lt;b&gt;x̃&lt;/b&gt;) &amp;nbsp;&amp;nbsp;&lt;b&gt;with physical permafrost bound&lt;/b&gt; D(&lt;b&gt;x&lt;/b&gt;) ≥ 0.05 m
  &lt;/div&gt;

  &lt;div style=&quot;font-weight:bold; font-size:13.5px; color:#0F172A; margin-top:12px; margin-bottom:5px;&quot;&gt;3 · Operational Resource Accessibility Index (RAI):&lt;/div&gt;
  &lt;div style=&quot;margin-left:14px;&quot;&gt;
    RAI(&lt;b&gt;x&lt;/b&gt;) = P(ice = 1 | &lt;b&gt;x&lt;/b&gt;) · exp(−D(&lt;b&gt;x&lt;/b&gt;) / 1.25 m) · f&lt;sub&gt;slope&lt;/sub&gt;(θ) · η&lt;sub&gt;EDL&lt;/sub&gt;(z) · (1 − 1.5 σ&lt;sub&gt;prob&lt;/sub&gt;(&lt;b&gt;x&lt;/b&gt;))&lt;br&gt;
    &lt;span style=&quot;color:#64748B; font-size:11px;&quot;&gt;where &amp;nbsp;f&lt;sub&gt;slope&lt;/sub&gt;(θ) = max(1 − θ / 10°, 0), &amp;nbsp;&amp;nbsp;η&lt;sub&gt;EDL&lt;/sub&gt;(z) = clip((−z − 1500 m) / 2500 m, 0, 1)&lt;br&gt;
    (1 − 1.5 σ&lt;sub&gt;prob&lt;/sub&gt;) penalizes epistemic variance; &amp;nbsp;exp(−D / 1.25 m) models mechanical drilling limit (D&lt;sub&gt;0&lt;/sub&gt; = 1.25 m)&lt;/span&gt;
  &lt;/div&gt;
&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=12.5;fontColor=#0F172A;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="668" y="556" width="672" height="340" as="geometry" />
        </mxCell>

        <!-- Right: Empirical Validation Scorecard Table -->
        <mxCell id="scoreCard" value="" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.5;" vertex="1" parent="1">
