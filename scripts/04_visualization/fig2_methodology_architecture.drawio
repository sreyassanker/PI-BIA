        </mxCell>

        <!-- Permafrost Cryosphere Card -->
        <mxCell id="cryoCard" value="&lt;b&gt;Martian Permafrost Cryosphere&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px; color:#0369A1; line-height:1.3;&quot;&gt;• Pore-filling ice matrix &amp;amp; massive excess ice sheets&lt;br&gt;• Thermodynamically stable at high northern latitudes&lt;br&gt;• Unresolved by coarse orbital footprints (~300–600 km)&lt;br&gt;• Fused via PI-BIA physics-constrained learning&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#38BDF8;strokeWidth=1.2;fontFamily=Helvetica;fontSize=11;fontColor=#0284C7;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1">
          <mxGeometry x="105" y="374" width="220" height="196" as="geometry" />
        </mxCell>

        <!-- Scale Break Band (Unified Across Both Columns) -->
