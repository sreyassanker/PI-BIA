          <mxGeometry x="95" y="744" width="240" height="2" as="geometry" />
        </mxCell>
        <mxCell id="reflectorText" value="&lt;b&gt;Dielectric Reflector Horizon (Δε&apos; ≈ 2.4–4.9)&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=9.5;fontColor=#0369A1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="95" y="748" width="240" height="18" as="geometry" />
        </mxCell>

        <!-- Basaltic Bedrock Basement -->
        <mxCell id="bedrock" value="&lt;b&gt;Basaltic Bedrock Basement (ε&apos; ≈ 5.5–8.0)&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#334155;strokeColor=#1E293B;fontFamily=Helvetica;fontSize=10.5;fontStyle=1;fontColor=#FFFFFF;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="95" y="772" width="240" height="53" as="geometry" />
        </mxCell>

        <!-- ===================== PANEL A: COLUMN 2 (SENSING LIMITS) ===================== -->
        <!-- Card 1: Shallow Sensing Reach (0–1 m) -->
        <mxCell id="card1" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#0284C7;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="365" y="148" width="240" height="82" as="geometry" />
        </mxCell>
        <mxCell id="card1Title" value="&lt;b&gt;Shallow Nuclear &amp;amp; Optical Reach&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=12.5;fontStyle=1;fontColor=#0369A1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="365" y="152" width="240" height="18" as="geometry" />
        </mxCell>
        <mxCell id="card1Text" value="• &lt;b&gt;Odyssey GRS/HEND:&lt;/b&gt; epithermal neutrons;&lt;br&gt;  H moderation effective strictly at &amp;lt; 1 m&lt;br&gt;• &lt;b&gt;MRO HiRISE:&lt;/b&gt; crater excavations (0.25–0.9 m)&lt;br&gt;• &lt;b&gt;Phoenix Lander:&lt;/b&gt; in-situ trench proof (0.05 m)" style="text;html=1;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=10.5;fontColor=#334155;align=left;verticalAlign=top;whiteSpace=wrap;lineSpacing=1.25;" vertex="1" parent="1">
          <mxGeometry x="372" y="171" width="226" height="54" as="geometry" />
        </mxCell>

        <!-- Card 2: Blind Zone / No Direct Coverage (1–10 m) -->
        <mxCell id="card2" value="" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#FFF1F2;strokeColor=#DC2626;strokeWidth=2;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="365" y="230" width="240" height="360" as="geometry" />
        </mxCell>
        <mxCell id="card2Title" value="&lt;b&gt;NO DIRECT ORBITAL COVERAGE&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=13.5;fontStyle=1;fontColor=#991B1B;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="365" y="240" width="240" height="24" as="geometry" />
        </mxCell>
        <mxCell id="card2Sub" value="&lt;b&gt;Physical Causes of the 1–10 m Gap:&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=11.5;fontStyle=1;fontColor=#7F1D1D;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="376" y="272" width="220" height="20" as="geometry" />
        </mxCell>
        <mxCell id="card2Text" value="&lt;b&gt;1. Neutron Moderation Cutoff:&lt;/b&gt;&lt;br&gt;Hydrogen moderates epithermal flux strictly in the top ~1 m; deeper ice produces zero surface suppression.&lt;br&gt;&lt;br&gt;&lt;b&gt;2. Radar Clutter &amp;amp; Pulse Length:&lt;/b&gt;&lt;br&gt;SHARAD pulse (~15 m free-space) &amp;amp; surface clutter obscure the uppermost 10–15 m.&lt;br&gt;&lt;br&gt;&lt;b&gt;3. Crater Excavation Geometry:&lt;/b&gt;&lt;br&gt;Fresh craters rarely sample 1–10 m without extensive fall-back debris.&lt;br&gt;&lt;br&gt;&lt;b&gt;Criticality for In-Situ Exploration:&lt;/b&gt;&lt;br&gt;This unobserved gap contains the primary mechanical drilling depth for human water extraction." style="text;html=1;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=10.5;fontColor=#4C0519;align=left;verticalAlign=top;whiteSpace=wrap;lineSpacing=1.28;" vertex="1" parent="1">
          <mxGeometry x="375" y="298" width="220" height="280" as="geometry" />
        </mxCell>

        <!-- Card 3: Orbital Radar Sounders (> 15 m) -->
        <mxCell id="card3" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#0284C7;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="365" y="640" width="240" height="185" as="geometry" />
        </mxCell>
        <mxCell id="card3Title" value="&lt;b&gt;Orbital Radar Sounders (&amp;gt; 15 m)&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=12.5;fontStyle=1;fontColor=#0369A1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="365" y="648" width="240" height="22" as="geometry" />
        </mxCell>
        <mxCell id="card3Text" value="• &lt;b&gt;MRO SHARAD:&lt;/b&gt; 15–25 MHz chirp (~15 m res)&lt;br&gt;• &lt;b&gt;MEX MARSIS:&lt;/b&gt; 1.8–5.0 MHz sounder&lt;br&gt;&lt;br&gt;Resolves dielectric boundary reflections strictly at depths &amp;gt; 15–20 m;&lt;br&gt;&lt;b&gt;blind to upper 1–10 m regolith overburden.&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=11;fontColor=#334155;align=left;verticalAlign=top;whiteSpace=wrap;lineSpacing=1.3;" vertex="1" parent="1">
