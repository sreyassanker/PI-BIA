        </mxCell>
        <mxCell id="scoreTitle" value="&lt;b&gt;Empirical Validation Scorecard&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=13.5;fontStyle=1;fontColor=#0F172A;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1378" y="520" width="390" height="22" as="geometry" />
        </mxCell>
        <mxCell id="scoreSub" value="&lt;i&gt;Calibrated on N = 26 authentic Martian benchmark sites&lt;/i&gt;" style="text;html=1;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=10.5;fontColor=#64748B;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1378" y="542" width="390" height="16" as="geometry" />
        </mxCell>
        <mxCell id="scoreDiv" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E2E8F0;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="1390" y="562" width="366" height="1.5" as="geometry" />
        </mxCell>

        <!-- Complete 8-Row Validation Table (Ample Height to Prevent Clipping) -->
        <mxCell id="scoreTable" value="&lt;table style=&quot;width:100%; border-collapse:collapse; font-family:Helvetica; font-size:12px; color:#1E293B;&quot;&gt;
  &lt;tr style=&quot;border-bottom:1.5px solid #CBD5E1; background-color:#F1F5F9;&quot;&gt;
    &lt;th style=&quot;padding:5px 6px; text-align:left; font-weight:bold; color:#0F172A; font-size:10.5px; text-transform:uppercase;&quot;&gt;Validation Metric&lt;/th&gt;
    &lt;th style=&quot;padding:5px 6px; text-align:right; font-weight:bold; color:#0F172A; font-size:10.5px; text-transform:uppercase;&quot;&gt;Value&lt;/th&gt;
    &lt;th style=&quot;padding:5px 6px; text-align:right; font-weight:bold; color:#64748B; font-size:10px;&quot;&gt;Method / Scale&lt;/th&gt;
  &lt;/tr&gt;
  &lt;tr style=&quot;border-bottom:1px solid #E2E8F0;&quot;&gt;
    &lt;td style=&quot;padding:5px 6px; text-align:left;&quot;&gt;Benchmark Sites&lt;/td&gt;
    &lt;td style=&quot;padding:5px 6px; text-align:right; font-weight:bold; color:#0F172A;&quot;&gt;N = 26&lt;/td&gt;
    &lt;td style=&quot;padding:5px 6px; text-align:right; color:#64748B; font-size:10px;&quot;&gt;16 ice / 10 dry&lt;/td&gt;
  &lt;/tr&gt;
  &lt;tr style=&quot;background-color:#F8FAFC; border-bottom:1px solid #E2E8F0;&quot;&gt;
    &lt;td style=&quot;padding:5px 6px; text-align:left;&quot;&gt;ROC-AUC&lt;/td&gt;
    &lt;td style=&quot;padding:5px 6px; text-align:right; font-weight:bold; color:#0F172A;&quot;&gt;0.931&lt;/td&gt;
    &lt;td style=&quot;padding:5px 6px; text-align:right; color:#64748B; font-size:10px;&quot;&gt;Binary discrimination&lt;/td&gt;
  &lt;/tr&gt;
  &lt;tr style=&quot;border-bottom:1px solid #E2E8F0;&quot;&gt;
    &lt;td style=&quot;padding:5px 6px; text-align:left;&quot;&gt;In-Sample F1&lt;/td&gt;
    &lt;td style=&quot;padding:5px 6px; text-align:right; font-weight:bold; color:#0F172A;&quot;&gt;0.867&lt;/td&gt;
    &lt;td style=&quot;padding:5px 6px; text-align:right; color:#64748B; font-size:10px;&quot;&gt;Decision thresh P = 0.50&lt;/td&gt;
  &lt;/tr&gt;
  &lt;tr style=&quot;background-color:#F8FAFC; border-bottom:1px solid #E2E8F0;&quot;&gt;
    &lt;td style=&quot;padding:5px 6px; text-align:left;&quot;&gt;5-Fold Stratified CV F1&lt;/td&gt;
    &lt;td style=&quot;padding:5px 6px; text-align:right; font-weight:bold; color:#0F172A;&quot;&gt;0.786 ± 0.072&lt;/td&gt;
    &lt;td style=&quot;padding:5px 6px; text-align:right; color:#64748B; font-size:10px;&quot;&gt;Out-of-fold generalization&lt;/td&gt;
  &lt;/tr&gt;
  &lt;tr style=&quot;border-bottom:1px solid #E2E8F0;&quot;&gt;
    &lt;td style=&quot;padding:5px 6px; text-align:left;&quot;&gt;Depth LOOCV RMSE&lt;/td&gt;
    &lt;td style=&quot;padding:5px 6px; text-align:right; font-weight:bold; color:#0F172A;&quot;&gt;0.0955 m&lt;/td&gt;
    &lt;td style=&quot;padding:5px 6px; text-align:right; color:#64748B; font-size:10px;&quot;&gt;Leave-one-out CV (9.6 cm)&lt;/td&gt;
  &lt;/tr&gt;
  &lt;tr style=&quot;background-color:#F8FAFC; border-bottom:1px solid #E2E8F0;&quot;&gt;
    &lt;td style=&quot;padding:5px 6px; text-align:left;&quot;&gt;Depth In-Sample MAE&lt;/td&gt;
    &lt;td style=&quot;padding:5px 6px; text-align:right; font-weight:bold; color:#0F172A;&quot;&gt;0.0449 m&lt;/td&gt;
    &lt;td style=&quot;padding:5px 6px; text-align:right; color:#64748B; font-size:10px;&quot;&gt;Mean absolute error (4.5 cm)&lt;/td&gt;
  &lt;/tr&gt;
  &lt;tr style=&quot;border-bottom:1px solid #E2E8F0;&quot;&gt;
    &lt;td style=&quot;padding:5px 6px; text-align:left;&quot;&gt;Calibration ECE&lt;/td&gt;
    &lt;td style=&quot;padding:5px 6px; text-align:right; font-weight:bold; color:#0F172A;&quot;&gt;0.123&lt;/td&gt;
    &lt;td style=&quot;padding:5px 6px; text-align:right; color:#64748B; font-size:10px;&quot;&gt;10-bin expected error&lt;/td&gt;
  &lt;/tr&gt;
  &lt;tr style=&quot;background-color:#F8FAFC;&quot;&gt;
    &lt;td style=&quot;padding:5px 6px; text-align:left;&quot;&gt;Laplace Epistemic σ&lt;/td&gt;
    &lt;td style=&quot;padding:5px 6px; text-align:right; font-weight:bold; color:#0F172A;&quot;&gt;0.146 ± 0.047&lt;/td&gt;
    &lt;td style=&quot;padding:5px 6px; text-align:right; color:#64748B; font-size:10px;&quot;&gt;Dynamic posterior&lt;/td&gt;
  &lt;/tr&gt;
&lt;/table&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=top;" vertex="1" parent="1">
