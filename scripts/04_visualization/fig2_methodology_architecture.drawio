        </mxCell>
        <mxCell id="bTitle" value="Physics-informed Bayesian inversion architecture (PI-BIA)" style="text;html=1;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=16.5;fontStyle=1;fontColor=#0F172A;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="688" y="40" width="600" height="28" as="geometry" />
        </mxCell>
        <mxCell id="bSub" value="End-to-end framework integrating multi-modal planetary sensing, thermodynamic constraints, and uncertainty quantification" style="text;html=1;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=11.5;fontStyle=2;fontColor=#64748B;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="688" y="70" width="850" height="20" as="geometry" />
        </mxCell>

        <!-- ===================== PANEL B: COMPACT STAGES (HEIGHT REDUCED TO 310 px) ===================== -->
        <!-- Box 1: Multi-Modal Inputs -->
        <mxCell id="box1" value="" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E3A8A;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="650" y="142" width="236" height="312" as="geometry" />
        </mxCell>
        <mxCell id="box1Head" value="&lt;b&gt;1 · Multi-Modal Inputs&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#1E3A8A;strokeColor=none;fontFamily=Helvetica;fontSize=13.5;fontColor=#FFFFFF;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="650" y="142" width="236" height="32" as="geometry" />
        </mxCell>
        <mxCell id="box1Sub" value="&lt;i&gt;NASA PDS Archives &amp;amp; In-Situ Benchmarks&lt;/i&gt;" style="text;html=1;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=10.5;fontColor=#64748B;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="650" y="176" width="236" height="18" as="geometry" />
        </mxCell>
        <mxCell id="box1Div" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E2E8F0;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="660" y="196" width="216" height="1.5" as="geometry" />
        </mxCell>
        <mxCell id="box1Body" value="&lt;div style=&quot;font-size:10.5px; line-height:1.24;&quot;&gt;
  &lt;div style=&quot;font-weight:bold; color:#0F172A; margin-bottom:2px;&quot;&gt;Orbital Remote Sensing:&lt;/div&gt;
  &lt;div style=&quot;margin-left:2px; margin-bottom:5px;&quot;&gt;
    &lt;div style=&quot;font-weight:bold; color:#0F172A;&quot;&gt;• MGS MOLA MEGDR Topography&lt;/div&gt;
    &lt;div style=&quot;margin-left:9px; color:#334155; font-size:10px;&quot;&gt;64 pix/deg global grid (926 m/pix)&lt;br&gt;Elevation: −4995 to −2804 m&lt;/div&gt;
  &lt;/div&gt;
  &lt;div style=&quot;margin-left:2px; margin-bottom:6px;&quot;&gt;
    &lt;div style=&quot;font-weight:bold; color:#0F172A;&quot;&gt;• Mars Odyssey GRS / HEND&lt;/div&gt;
    &lt;div style=&quot;margin-left:9px; color:#334155; font-size:10px;&quot;&gt;Corrected Epithermal Neutron Flux (CEPI)&lt;br&gt;Spatial resolution: ~5° FWHM (~300 km)&lt;/div&gt;
  &lt;/div&gt;
  &lt;div style=&quot;font-weight:bold; color:#0F172A; margin-bottom:2px;&quot;&gt;Authentic Benchmarks (N = 26):&lt;/div&gt;
  &lt;div style=&quot;margin-left:2px; margin-bottom:3px;&quot;&gt;
    &lt;div style=&quot;color:#0F172A;&quot;&gt;&lt;font color=&quot;#0284C7&quot;&gt;●&lt;/font&gt; &lt;b&gt;Fresh Ice Craters (n = 15)&lt;/b&gt;&lt;/div&gt;
    &lt;div style=&quot;margin-left:9px; color:#334155; font-size:10px;&quot;&gt;HiRISE excavations (0.25–0.90 m)&lt;/div&gt;
  &lt;/div&gt;
  &lt;div style=&quot;margin-left:2px; margin-bottom:3px;&quot;&gt;
    &lt;div style=&quot;color:#0F172A;&quot;&gt;&lt;font color=&quot;#0284C7&quot;&gt;■&lt;/font&gt; &lt;b&gt;Phoenix Lander Trench (n = 1)&lt;/b&gt;&lt;/div&gt;
    &lt;div style=&quot;margin-left:9px; color:#334155; font-size:10px;&quot;&gt;In-situ ice anchor (0.05 m depth)&lt;/div&gt;
  &lt;/div&gt;
  &lt;div style=&quot;margin-left:2px;&quot;&gt;
    &lt;div style=&quot;color:#0F172A;&quot;&gt;&lt;font color=&quot;#DC2626&quot;&gt;■&lt;/font&gt; &lt;b&gt;Non-Icy Controls (n = 10)&lt;/b&gt;&lt;/div&gt;
    &lt;div style=&quot;margin-left:9px; color:#334155; font-size:10px;&quot;&gt;Verified dry craters (Dundas 2014 / HiRISE)&lt;/div&gt;
  &lt;/div&gt;
&lt;/div&gt;" style="text;html=1;fontFamily=Helvetica;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="660" y="208" width="216" height="236" as="geometry" />
        </mxCell>

        <!-- Box 2: Spatial Preprocessing -->
        <mxCell id="box2" value="" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B45309;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="944" y="142" width="236" height="312" as="geometry" />
        </mxCell>
        <mxCell id="box2Head" value="&lt;b&gt;2 · Spatial Preprocessing&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#B45309;strokeColor=none;fontFamily=Helvetica;fontSize=13.5;fontColor=#FFFFFF;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="944" y="142" width="236" height="32" as="geometry" />
        </mxCell>
        <mxCell id="box2Sub" value="&lt;i&gt;Co-Registered Multi-Modal Spatial Cube&lt;/i&gt;" style="text;html=1;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=10.5;fontColor=#64748B;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="944" y="176" width="236" height="18" as="geometry" />
        </mxCell>
        <mxCell id="box2Div" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E2E8F0;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="954" y="196" width="216" height="1.5" as="geometry" />
        </mxCell>
        <mxCell id="box2Body" value="&lt;div style=&quot;font-size:10.5px; line-height:1.24;&quot;&gt;
  &lt;div style=&quot;font-weight:bold; color:#0F172A; margin-bottom:2px;&quot;&gt;Arcadia Study Corridor:&lt;/div&gt;
  &lt;div style=&quot;margin-left:2px; margin-bottom:5px; color:#334155; font-size:10px;&quot;&gt;
    • Latitude: 37°N to 50°N &amp;nbsp;|&amp;nbsp; Lon: 180°E to 205°E&lt;br&gt;
    • High-res grid: 832 × 1600 cells (1.33M pixels)
  &lt;/div&gt;
  &lt;div style=&quot;font-weight:bold; color:#0F172A; margin-bottom:2px;&quot;&gt;Derived Geomorphology:&lt;/div&gt;
  &lt;div style=&quot;margin-left:2px; margin-bottom:5px; color:#334155; font-size:10px;&quot;&gt;
    • &lt;b&gt;Elevation:&lt;/b&gt; z from MOLA MEGDR datum&lt;br&gt;
    • &lt;b&gt;Slope gradient:&lt;/b&gt; θ = arctan(|∇z|), mean: 0.36°&lt;br&gt;
    • &lt;b&gt;CEPI flux:&lt;/b&gt; smooth bicubic to 64 pix/deg
  &lt;/div&gt;
  &lt;div style=&quot;font-weight:bold; color:#0F172A; margin-bottom:2px;&quot;&gt;Standardized Feature Vector:&lt;/div&gt;
  &lt;div style=&quot;margin-left:2px; color:#334155; font-size:10px;&quot;&gt;
    • &lt;b&gt;x&lt;/b&gt; = [φ, λ, z, θ, Φ&lt;sub&gt;epi&lt;/sub&gt;]&lt;sup&gt;T&lt;/sup&gt; ∈ ℝ&lt;sup&gt;5&lt;/sup&gt; (φ: lat, Φ&lt;sub&gt;epi&lt;/sub&gt;: CEPI)&lt;br&gt;
    • Robust z-score: &lt;b&gt;x̃&lt;/b&gt; = (&lt;b&gt;x&lt;/b&gt; − &lt;b&gt;μ&lt;/b&gt;) / &lt;b&gt;σ&lt;/b&gt; (no feature clamping)
  &lt;/div&gt;
&lt;/div&gt;" style="text;html=1;fontFamily=Helvetica;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="954" y="208" width="216" height="236" as="geometry" />
        </mxCell>

        <!-- Box 3: PI-BIA Inversion -->
        <mxCell id="box3" value="" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0D9488;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="1238" y="142" width="236" height="312" as="geometry" />
        </mxCell>
        <mxCell id="box3Head" value="&lt;b&gt;3 · PI-BIA Inversion&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#0D9488;strokeColor=none;fontFamily=Helvetica;fontSize=13.5;fontColor=#FFFFFF;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1238" y="142" width="236" height="32" as="geometry" />
        </mxCell>
        <mxCell id="box3Sub" value="&lt;i&gt;Dual-Stage Physics Engine &amp;amp; Uncertainty&lt;/i&gt;" style="text;html=1;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=10.5;fontColor=#64748B;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1238" y="176" width="236" height="18" as="geometry" />
        </mxCell>
        <mxCell id="box3Div" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E2E8F0;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="1248" y="196" width="216" height="1.5" as="geometry" />
        </mxCell>
        <mxCell id="box3Body" value="&lt;div style=&quot;font-size:10.5px; line-height:1.24;&quot;&gt;
  &lt;div style=&quot;font-weight:bold; color:#0F172A; margin-bottom:2px;&quot;&gt;Stage I: Ice Detection P(ice)&lt;/div&gt;
  &lt;div style=&quot;margin-left:2px; margin-bottom:5px; color:#334155; font-size:10px;&quot;&gt;
    • Physics-Constrained Logistic Model&lt;br&gt;
    • Monotonicity Bounds: β&lt;sub&gt;CEPI&lt;/sub&gt; ≤ 0, β&lt;sub&gt;lat&lt;/sub&gt; ≥ 0&lt;br&gt;
    • Bounded L-BFGS-B optimization (λ = 0.5)
  &lt;/div&gt;
  &lt;div style=&quot;font-weight:bold; color:#0F172A; margin-bottom:2px;&quot;&gt;Stage II: Depth Inversion D(x)&lt;/div&gt;
  &lt;div style=&quot;margin-left:2px; margin-bottom:5px; color:#334155; font-size:10px;&quot;&gt;
    • Bayesian Ridge (calibrated on n = 16 ice sites)&lt;br&gt;
    • Predictive posterior: D ~ 𝒩(μ&lt;sub&gt;D&lt;/sub&gt;, σ&lt;sub&gt;D&lt;/sub&gt;&lt;sup&gt;2&lt;/sup&gt;)&lt;br&gt;
    • Physical lower bound: D ≥ 0.05 m
  &lt;/div&gt;
  &lt;div style=&quot;font-weight:bold; color:#0F172A; margin-bottom:2px;&quot;&gt;Laplace Epistemic Uncertainty:&lt;/div&gt;
  &lt;div style=&quot;margin-left:2px; color:#334155; font-size:10px;&quot;&gt;
    • Laplace Hessian &lt;b&gt;H&lt;/b&gt; = ∇&lt;sup&gt;2&lt;/sup&gt;(−log p)&lt;br&gt;
    • Covariance: &lt;b&gt;Σ&lt;/b&gt; = (&lt;b&gt;H&lt;/b&gt; + λ&lt;b&gt;I&lt;/b&gt;)&lt;sup&gt;−1&lt;/sup&gt;&lt;br&gt;
    • Epistemic variance: σ&lt;sub&gt;prob&lt;/sub&gt;&lt;sup&gt;2&lt;/sup&gt; = (∇P)&lt;sup&gt;T&lt;/sup&gt;&lt;b&gt;Σ&lt;/b&gt;(∇P)
  &lt;/div&gt;
&lt;/div&gt;" style="text;html=1;fontFamily=Helvetica;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="1248" y="208" width="216" height="236" as="geometry" />
        </mxCell>

        <!-- Box 4: Outputs & Validation -->
        <mxCell id="box4" value="" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#15803D;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="1532" y="142" width="236" height="312" as="geometry" />
        </mxCell>
        <mxCell id="box4Head" value="&lt;b&gt;4 · Outputs &amp;amp; Validation&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#15803D;strokeColor=none;fontFamily=Helvetica;fontSize=13.5;fontColor=#FFFFFF;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1532" y="142" width="236" height="32" as="geometry" />
        </mxCell>
        <mxCell id="box4Sub" value="&lt;i&gt;Regional Grids &amp;amp; Operational Artifacts&lt;/i&gt;" style="text;html=1;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=10.5;fontColor=#64748B;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1532" y="176" width="236" height="18" as="geometry" />
        </mxCell>
        <mxCell id="box4Div" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E2E8F0;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="1542" y="196" width="216" height="1.5" as="geometry" />
        </mxCell>
        <mxCell id="box4Body" value="&lt;div style=&quot;font-size:10.5px; line-height:1.24;&quot;&gt;
  &lt;div style=&quot;font-weight:bold; color:#0F172A; margin-bottom:2px;&quot;&gt;Regional Planetary Grids:&lt;/div&gt;
  &lt;div style=&quot;margin-left:2px; margin-bottom:5px; color:#334155; font-size:10px;&quot;&gt;
    • Occurrence probability grid P(ice)&lt;br&gt;
    • Ice-table depth raster D(x, y) (m)&lt;br&gt;
    • Laplace epistemic uncertainty σ&lt;sub&gt;prob&lt;/sub&gt;&lt;br&gt;
    • Resource Accessibility Index (RAI):&lt;br&gt;
    &#160;&#160;&lt;span style=&quot;font-size:9.5px;&quot;&gt;RAI = P(ice) · e&lt;sup&gt;−D/1.25&lt;/sup&gt; · f(θ) · η&lt;sub&gt;EDL&lt;/sub&gt; · (1 − 1.5 σ&lt;sub&gt;prob&lt;/sub&gt;)&lt;/span&gt;
  &lt;/div&gt;
  &lt;div style=&quot;font-weight:bold; color:#0F172A; margin-bottom:2px;&quot;&gt;Candidate Landing Sites:&lt;/div&gt;
  &lt;div style=&quot;margin-left:2px; margin-bottom:5px; color:#334155; font-size:10px;&quot;&gt;
    • Top-5 RAI-ranked landing sites&lt;br&gt;
    • Criteria: elevation &amp;lt; −3900 m, slope &amp;lt; 1.0°
  &lt;/div&gt;
  &lt;div style=&quot;font-weight:bold; color:#0F172A; margin-bottom:2px;&quot;&gt;Scientific Verification Deliverables:&lt;/div&gt;
  &lt;div style=&quot;margin-left:2px; color:#334155; font-size:10px;&quot;&gt;
    • Complete data cube (&lt;b&gt;.npz&lt;/b&gt; &amp;amp; &lt;b&gt;.json&lt;/b&gt;)&lt;br&gt;
    • Stratified CV &amp;amp; LOOCV benchmark validation&lt;br&gt;
    • Performance metrics tabulated in scorecard below
  &lt;/div&gt;
&lt;/div&gt;" style="text;html=1;fontFamily=Helvetica;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="1542" y="208" width="216" height="236" as="geometry" />
        </mxCell>

